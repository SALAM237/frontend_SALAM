# ── URLs ──────────────────────────────────────────────────
# URL de ce frontend (Vercel)
NEXT_PUBLIC_SITE_URL=https://salam-cameroun.com

# URL du backend Express sur Railway (sans slash final)
NEXT_PUBLIC_API_URL=https://backendsalam-production.up.railway.app

# Pour le développement local, gardez localhost dans .env.local seulement
# NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Identité SALAM ─────────────────────────────────────────
NEXT_PUBLIC_SITE_DOMAIN=salam-cameroun.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@salam-cameroun.com

# ── Supervision Sentry (Next.js / Vercel) ────────────────
# Le DSN est un identifiant public d'ingestion. Le token d'authentification,
# lui, reste secret et doit être configuré uniquement dans Vercel.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=salam-cameroun
SENTRY_PROJECT=salam_cameroun
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
